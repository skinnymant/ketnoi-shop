# ============================================================
# MẪU BIẾN MÔI TRƯỜNG CHO SELF-HOST TRÊN LAPTOP (docker-compose.laptop.yml)
# Copy thành ".env" cùng thư mục và điền giá trị THẬT. ĐỔI HẾT mật khẩu demo.
# Thay "swephuthovietnam.vn" bằng tên miền thật của bạn.
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=swe
POSTGRES_PASSWORD=DOI_MAT_KHAU_MANH_O_DAY
POSTGRES_DB=swe_shop

# ---- MinIO (lưu ảnh, chuẩn S3) ----
MINIO_ROOT_USER=swe
MINIO_ROOT_PASSWORD=DOI_MAT_KHAU_MANH_O_DAY
MINIO_BUCKET=ketnoi-media
# URL công khai để xem ảnh — trỏ tới subdomain media qua Cloudflare Tunnel
MINIO_PUBLIC_URL=https://media.swevietnam.com

# ---- API (backend) ----
# Sinh chuỗi ngẫu nhiên dài: mở Ubuntu gõ  openssl rand -hex 32
JWT_SECRET=DOI_THANH_CHUOI_NGAU_NHIEN_DAI
JWT_EXPIRES=7d
# Tài khoản quản trị đăng nhập /admin — ĐỪNG để admin123
ADMIN_EMAIL=admin@swevietnam.com
ADMIN_PASSWORD=DOI_MAT_KHAU_ADMIN_MANH
# Domain frontend (Vercel) được phép gọi API
CORS_ORIGINS=https://swevietnam.com,https://www.swevietnam.com

# ---- Cloudflare Tunnel ----
# Token lấy ở Cloudflare Zero Trust → Networks → Tunnels → (tunnel của bạn) → Install connector
CLOUDFLARE_TUNNEL_TOKEN=DAN_TOKEN_CLOUDFLARE_VAO_DAY
