# ============================================================
# MẪU BIẾN MÔI TRƯỜNG CHO TRIỂN KHAI (VPS + docker-compose.prod.yml)
# Copy thành ".env" cùng thư mục và điền giá trị THẬT. TUYỆT ĐỐI đổi các mật khẩu.
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=ketnoi
POSTGRES_PASSWORD=DOI_MAT_KHAU_MANH_O_DAY
POSTGRES_DB=ketnoi_shop

# ---- MinIO (lưu ảnh, S3-compatible) ----
MINIO_ROOT_USER=ketnoi
MINIO_ROOT_PASSWORD=DOI_MAT_KHAU_MANH_O_DAY
MINIO_BUCKET=ketnoi-media
# URL công khai để truy cập ảnh (trỏ tới subdomain media qua Caddy)
MINIO_PUBLIC_URL=https://media.yourdomain.com

# ---- API (backend) ----
# Chuỗi ngẫu nhiên dài, bí mật (VD: openssl rand -hex 32)
JWT_SECRET=DOI_THANH_CHUOI_NGAU_NHIEN_DAI
JWT_EXPIRES=7d
# Tài khoản quản trị
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=DOI_MAT_KHAU_ADMIN
# Domain frontend được phép gọi API (nhiều domain ngăn cách bằng dấu phẩy)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
