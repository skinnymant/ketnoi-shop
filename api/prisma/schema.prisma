// =====================================================================
// KETNOI-SHOP — SCHEMA DATABASE HOÀN CHỈNH (Bước 2.3)
// 34 bảng, khớp thiết kế ERD Phần 3: Catalog / Sales / Content / System
// Cách dùng: thay TOÀN BỘ nội dung file api/prisma/schema.prisma bằng file này
// rồi chạy:  npx prisma migrate dev --name init
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================= ENUMS =================================
// Enum = danh sách giá trị cho phép, tránh gõ sai chuỗi tùy tiện

enum OrderStatus {
  PENDING // Chờ xác nhận
  CONFIRMED // Đã xác nhận
  SHIPPING // Đang giao
  COMPLETED // Hoàn thành
  CANCELLED // Đã hủy
}

enum PaymentMethod {
  COD // Thanh toán khi nhận hàng
  BANK_TRANSFER // Chuyển khoản VietQR
  VNPAY // Cổng VNPay
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENT // Giảm theo %
  FIXED // Giảm số tiền cố định
}

enum PromotionType {
  BOGO // Mua 1 tặng 1
  GIFT // Quà tặng kèm
  COMBO // Combo tiết kiệm
  FLASH_SALE // Giảm giá giờ vàng
}

enum PostType {
  NEWS // Tin khuyến mãi
  BLOG // Tư vấn kết nối
  POLICY // Trang chính sách
}

enum ContentStatus {
  DRAFT // Nháp
  PUBLISHED // Đã đăng
  HIDDEN // Ẩn
}

enum ReviewStatus {
  PENDING // Chờ duyệt
  APPROVED // Đã duyệt
  REJECTED // Từ chối
}

// ======================= NHÓM 1: CATALOG =============================

model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  level     Int        @default(1) // 1, 2, 3 — cây 3 cấp
  imageUrl  String?    @map("image_url")
  position  Int        @default(0) // thứ tự hiển thị trong menu
  isActive  Boolean    @default(true) @map("is_active")
  // Quan hệ tự trỏ: danh mục cha - con
  parentId  String?    @map("parent_id")
  parent    Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryChildren")
  products  Product[]
  // SEO riêng từng danh mục
  seoTitle  String?    @map("seo_title")
  seoDesc   String?    @map("seo_desc")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at") // xóa mềm

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  logoUrl   String?   @map("logo_url")
  description String? @db.Text
  isActive  Boolean   @default(true) @map("is_active")
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("brands")
}

model Supplier {
  id        String    @id @default(uuid())
  name      String
  phone     String?
  email     String?
  address   String?
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("suppliers")
}

model Product {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  sku         String    @unique // mã hàng nội bộ
  description String?   @db.Text // bài mô tả dài (HTML)
  shortDesc   String?   @map("short_desc")
  price       Decimal   @db.Decimal(14, 0) // giá gốc (VND không lẻ)
  salePrice   Decimal?  @map("sale_price") @db.Decimal(14, 0) // giá bán sau giảm
  soldCount   Int       @default(0) @map("sold_count") // hiển thị "Đã bán N"
  isActive    Boolean   @default(true) @map("is_active")
  isFeatured  Boolean   @default(false) @map("is_featured") // sản phẩm nổi bật
  freeShip    Boolean   @default(false) @map("free_ship")
  warrantyMonths Int?   @map("warranty_months") // bảo hành (tháng)

  categoryId  String    @map("category_id")
  category    Category  @relation(fields: [categoryId], references: [id])
  brandId     String?   @map("brand_id")
  brand       Brand?    @relation(fields: [brandId], references: [id])
  supplierId  String?   @map("supplier_id")
  supplier    Supplier? @relation(fields: [supplierId], references: [id])

  images      ProductImage[]
  specs       ProductSpec[]
  inventory   Inventory[]
  orderItems  OrderItem[]
  cartItems   CartItem[]
  reviews     Review[]
  wishlistedBy WishlistItem[]
  promotions   PromotionProduct[] @relation("PromoProduct")
  giftInPromos PromotionProduct[] @relation("PromoGift")

  // SEO riêng từng sản phẩm
  seoTitle    String?   @map("seo_title")
  seoDesc     String?   @map("seo_desc")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive, isFeatured])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String? // mô tả ảnh cho SEO
  position  Int     @default(0)

  @@index([productId])
  @@map("product_images")
}

model ProductSpec {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  specName  String  @map("spec_name") // VD: "Điện áp"
  specValue String  @map("spec_value") // VD: "18V"
  position  Int     @default(0)

  @@index([productId])
  @@index([specName, specValue]) // phục vụ bộ lọc theo thông số
  @@map("product_specs")
}

model Warehouse {
  id        String      @id @default(uuid())
  name      String // VD: "Kho HCM", "Kho Hà Nội"
  address   String?
  phone     String?
  inventory Inventory[]
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@map("warehouses")
}

model Inventory {
  id          String    @id @default(uuid())
  productId   String    @map("product_id")
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String    @map("warehouse_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  quantity    Int       @default(0)
  lowStockAt  Int       @default(3) @map("low_stock_at") // ngưỡng cảnh báo sắp hết
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([productId, warehouseId]) // mỗi SP mỗi kho chỉ 1 dòng tồn
  @@map("inventory")
}

// ======================== NHÓM 2: SALES ==============================

model Customer {
  id             String     @id @default(uuid())
  email          String?    @unique
  phone          String?    @unique
  fullName       String     @map("full_name")
  passwordHash   String?    @map("password_hash") // null nếu đăng nhập Google
  googleId       String?    @unique @map("google_id")
  membershipTier String     @default("MEMBER") @map("membership_tier") // MEMBER/SILVER/GOLD
  isActive       Boolean    @default(true) @map("is_active")

  addresses     Address[]
  carts         Cart[]
  orders        Order[]
  reviews       Review[]
  wishlist      WishlistItem[]
  notifications Notification[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("customers")
}

model Address {
  id          String   @id @default(uuid())
  customerId  String   @map("customer_id")
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  receiverName String  @map("receiver_name")
  phone       String
  province    String // Tỉnh/TP
  district    String // Quận/Huyện
  ward        String // Phường/Xã
  street      String // Số nhà, tên đường
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([customerId])
  @@map("addresses")
}

model Cart {
  id         String     @id @default(uuid())
  customerId String?    @map("customer_id") // null = khách vãng lai
  customer   Customer?  @relation(fields: [customerId], references: [id])
  sessionId  String?    @unique @map("session_id") // định danh khách chưa đăng nhập
  items      CartItem[]
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@index([customerId])
  @@map("carts")
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String  @map("cart_id")
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  isGift    Boolean @default(false) @map("is_gift") // quà KM tự thêm

  @@unique([cartId, productId, isGift])
  @@map("cart_items")
}

model Order {
  id            String      @id @default(uuid())
  orderCode     String      @unique @map("order_code") // VD: KN20260704-001
  customerId    String?     @map("customer_id") // null = đơn khách vãng lai
  customer      Customer?   @relation(fields: [customerId], references: [id])

  // Thông tin nhận hàng "đóng băng" tại thời điểm đặt
  receiverName  String      @map("receiver_name")
  receiverPhone String      @map("receiver_phone")
  receiverEmail String?     @map("receiver_email")
  shippingAddress String    @map("shipping_address") // địa chỉ đầy đủ 1 dòng
  note          String?

  status        OrderStatus @default(PENDING)
  subtotal      Decimal     @db.Decimal(14, 0) // tạm tính
  discount      Decimal     @default(0) @db.Decimal(14, 0)
  shippingFee   Decimal     @default(0) @map("shipping_fee") @db.Decimal(14, 0)
  total         Decimal     @db.Decimal(14, 0)

  couponId      String?     @map("coupon_id")
  coupon        Coupon?     @relation(fields: [couponId], references: [id])

  items         OrderItem[]
  payments      Payment[]
  shipment      Shipment?
  cancelReason  String?     @map("cancel_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String  @map("order_id")
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String  @map("product_id")
  product     Product @relation(fields: [productId], references: [id])
  productName String  @map("product_name") // đóng băng tên tại thời điểm mua
  unitPrice   Decimal @map("unit_price") @db.Decimal(14, 0) // đóng băng giá
  quantity    Int
  isGift      Boolean @default(false) @map("is_gift")

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id        String        @id @default(uuid())
  orderId   String        @map("order_id")
  order     Order         @relation(fields: [orderId], references: [id])
  method    PaymentMethod
  status    PaymentStatus @default(PENDING)
  amount    Decimal       @db.Decimal(14, 0)
  reference String? // mã giao dịch từ cổng/ngân hàng
  paidAt    DateTime?     @map("paid_at")
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([orderId])
  @@map("payments")
}

model Shipment {
  id           String    @id @default(uuid())
  orderId      String    @unique @map("order_id")
  order        Order     @relation(fields: [orderId], references: [id])
  carrier      String? // hãng vận chuyển
  trackingCode String?   @map("tracking_code")
  shippedAt    DateTime? @map("shipped_at")
  deliveredAt  DateTime? @map("delivered_at")

  @@map("shipments")
}

model Coupon {
  id           String       @id @default(uuid())
  code         String       @unique // VD: GIAM5
  discountType DiscountType @map("discount_type")
  value        Decimal      @db.Decimal(14, 0) // 5 (%) hoặc 50000 (đ)
  minOrder     Decimal?     @map("min_order") @db.Decimal(14, 0) // đơn tối thiểu
  maxDiscount  Decimal?     @map("max_discount") @db.Decimal(14, 0) // trần giảm khi theo %
  usageLimit   Int?         @map("usage_limit") // tổng lượt dùng cho phép
  usedCount    Int          @default(0) @map("used_count")
  startDate    DateTime     @map("start_date")
  endDate      DateTime     @map("end_date")
  isActive     Boolean      @default(true) @map("is_active")
  orders       Order[]
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@map("coupons")
}

model Promotion {
  id        String             @id @default(uuid())
  name      String
  type      PromotionType
  startDate DateTime           @map("start_date")
  endDate   DateTime           @map("end_date")
  isActive  Boolean            @default(true) @map("is_active")
  products  PromotionProduct[]
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  @@map("promotions")
}

model PromotionProduct {
  id            String    @id @default(uuid())
  promotionId   String    @map("promotion_id")
  promotion     Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId     String    @map("product_id") // sản phẩm được áp KM
  product       Product   @relation("PromoProduct", fields: [productId], references: [id])
  giftProductId String?   @map("gift_product_id") // quà tặng kèm (nếu type GIFT/BOGO)
  giftProduct   Product?  @relation("PromoGift", fields: [giftProductId], references: [id])
  giftQuantity  Int       @default(1) @map("gift_quantity")

  @@index([productId])
  @@map("promotion_products")
}

model Review {
  id         String       @id @default(uuid())
  productId  String       @map("product_id")
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String       @map("customer_id")
  customer   Customer     @relation(fields: [customerId], references: [id])
  rating     Int // 1..5 sao
  content    String?      @db.Text
  status     ReviewStatus @default(PENDING) // admin duyệt mới hiện
  createdAt  DateTime     @default(now()) @map("created_at")

  @@unique([productId, customerId]) // mỗi khách 1 đánh giá / sản phẩm
  @@map("reviews")
}

model WishlistItem {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String   @map("product_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([customerId, productId])
  @@map("wishlist_items")
}

// =================== NHÓM 3: CONTENT & SYSTEM ========================

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  fullName     String     @map("full_name")
  passwordHash String     @map("password_hash")
  isActive     Boolean    @default(true) @map("is_active")
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id])
  posts        Post[]
  auditLogs    AuditLog[]
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // Admin, Kho, Biên tập...
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")

  @@map("roles")
}

model Permission {
  id    String           @id @default(uuid())
  code  String           @unique // VD: product.create, order.update
  name  String
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Post {
  id        String        @id @default(uuid())
  title     String
  slug      String        @unique
  excerpt   String? // mô tả ngắn
  content   String?       @db.Text // nội dung HTML
  coverUrl  String?       @map("cover_url")
  type      PostType      @default(BLOG)
  status    ContentStatus @default(DRAFT)
  authorId  String?       @map("author_id")
  author    User?         @relation(fields: [authorId], references: [id])
  comments  Comment[]
  tags      PostTag[]
  seoTitle  String?       @map("seo_title")
  seoDesc   String?       @map("seo_desc")
  publishedAt DateTime?   @map("published_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  deletedAt DateTime?     @map("deleted_at")

  @@index([type, status])
  @@map("posts")
}

model Comment {
  id        String        @id @default(uuid())
  postId    String        @map("post_id")
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorName String       @map("author_name")
  content   String        @db.Text
  status    ContentStatus @default(DRAFT) // duyệt mới hiện
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([postId])
  @@map("comments")
}

model Tag {
  id    String    @id @default(uuid())
  name  String    @unique
  slug  String    @unique
  posts PostTag[]

  @@map("tags")
}

model PostTag {
  postId String @map("post_id")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId  String @map("tag_id")
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  action    String // VD: product.update
  entity    String? // bảng bị tác động
  entityId  String?  @map("entity_id")
  detail    String?  @db.Text // JSON mô tả thay đổi
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("audit_logs")
}

model Banner {
  id       String   @id @default(uuid())
  imageUrl String   @map("image_url")
  link     String?
  title    String?
  position Int      @default(0) // 0 = slider chính, 1-2 = banner phụ...
  isActive Boolean  @default(true) @map("is_active")
  startAt  DateTime? @map("start_at")
  endAt    DateTime? @map("end_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("banners")
}

model Media {
  id        String   @id @default(uuid())
  url       String
  type      String // image/video/file
  sizeKb    Int?     @map("size_kb")
  alt       String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("media")
}

model Setting {
  key   String @id
  value String

  @@map("settings")
}

model Notification {
  id         String    @id @default(uuid())
  customerId String?   @map("customer_id") // null = thông báo chung
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title      String
  body       String?
  link       String?
  isRead     Boolean   @default(false) @map("is_read")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([customerId, isRead])
  @@map("notifications")
}
